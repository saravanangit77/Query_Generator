    },
    {
      "columnName": "status",
      "tableName": "issue",
      "description": "Current issue status (New, In Progress, Resolved, etc.)",
      "dataType": "string",
      "PK": null,
      "FK": null
    },
    {
      "columnName": "type",
      "tableName": "issue",
      "description": "Issue type (Issue, Request, Comment, etc.)",
      "dataType": "string",
      "PK": null,
      "FK": null
    },
    {
      "columnName": "createdby",
      "tableName": "issue",
      "description": "UUID of user who created the issue",
      "dataType": "string",
      "PK": null,
      "FK": null
    },
    {
      "columnName": "createdat",
      "tableName": "issue",
      "description": "Timestamp when issue was created",
      "dataType": "timestamp_tz",
      "PK": null,
      "FK": null
    },
    {
      "columnName": "marker",
      "tableName": "issue",
      "description": "3D marker/viewpoint data for issue location (JSON/variant)",
      "dataType": "variant",
      "PK": null,
      "FK": null
    },
    {
      "columnName": "referencelinks",
      "tableName": "issue",
      "description": "Array of reference URLs related to the issue",
      "dataType": "array",
      "PK": null,
      "FK": null
    },
    {
      "columnName": "source_region",
      "tableName": "activity",
      "description": "Geographic region where the data originated (us, eu, ap)",
      "dataType": "varchar",
      "PK": null,
      "FK": null
    },
    {
      "columnName": "source_region", 
      "tableName": "project",
      "description": "Geographic region where the project data originated",
      "dataType": "varchar",
      "PK": null,
      "FK": null
    },
    {
      "columnName": "source_region",
      "tableName": "storage_object",
      "description": "Geographic region where the file data originated",
      "dataType": "varchar",
      "PK": null,
      "FK": null
    }
  ],
  "relationships": [
    {
