      "PK": null,
      "FK": "storage_object.project_id = project.project_id"
    },
    {
      "columnName": "type",
      "tableName": "storage_object",
      "description": "Object type: FILE, FOLDER, etc.",
      "dataType": "varchar",
      "PK": null,
