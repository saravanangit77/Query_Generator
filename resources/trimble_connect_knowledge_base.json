{
  "database": "TRIMBLE_CONNECT_PROD",
  "schema": "ADMIN_SCHEMA", 
  "description": "Trimble Connect platform database schema with tables and views for project management, file storage, user management, and entitlements",
  "tables": [
    {
      "tableName": "activity",
      "description": "Stores user activity records within projects",
      "columns": ["activity_id", "user_id", "project_id", "scope", "action", "activity_created_on", "status", "source_region"]
    },
    {
      "tableName": "project", 
      "description": "Core project information and metadata",
      "columns": ["project_id", "name", "root_id", "has_image", "sync_setting", "is_deleted", "deleted_by", "project_deleted_on", "created_by", "project_created_on", "modified_by", "project_modified_on", "is_project_invite_restricted", "source_region"]
    },
    {
      "tableName": "activity_log",
      "description": "Detailed logging of activities performed on objects",
      "columns": ["activity_log_id", "activity_id", "object_id", "object_type_id", "action", "trigger_by", "activity_log_created_on", "source_region"]
    },
    {
      "tableName": "comment",
      "description": "Comments made on objects (files, todos, etc.) with attachment support",
      "columns": ["comment_id", "object_id", "object_type_id", "created_by", "modified_by", "deleted_by", "is_deleted", "comment_created_on", "comment_modified_on", "storage_object_id", "attachment_count", "source_region"]
    },
    {
      "tableName": "storage_object",
      "description": "Files and folders stored in projects with version control",
      "columns": ["storage_object_id", "orig_storage_object_id", "content_id", "revision", "type", "name", "project_id", "created_by", "modified_by", "size_in_bytes", "storage_object_created_on", "storage_object_modified_on", "flag", "tds_fs_id", "source_region"]
    },
    {
      "tableName": "storage_object_properties",
      "description": "Extended properties for storage objects including CAD metadata",
      "columns": ["storage_object_id", "header", "thumb_status_updated", "file_name", "header_timestamp", "model_author", "modeling_software", "modeling_software_version", "modeling_database_version", "source_region"]
    },
    {
      "tableName": "storage_object_status",
      "description": "Processing status for storage objects (thumbnail, conversion, etc.)",
      "columns": ["storage_object_id", "status_type", "status", "progress", "execution_id", "modified", "source_region"]
    },
    {
      "tableName": "user",
      "description": "User accounts with Trimble ID integration",
      "columns": ["user_id", "tid_uuid", "status", "type", "trn", "has_image", "user_created_on", "user_modified_on"]
    },
    {
      "tableName": "user_group",
      "description": "User groups within projects for permission management",
      "columns": ["user_group_id", "created_by", "modified_by", "company_id", "project_id", "is_deleted", "deleted_by", "user_group_created_on", "user_group_modified_on", "source_region"]
    },
    {
      "tableName": "company",
      "description": "Company information for enterprise accounts",
      "columns": ["company_id", "company_name", "company_abbreviation", "company_website", "has_image", "created_by", "created", "modified", "modified_by"]
    },
    {
      "tableName": "company_user_mapping",
      "description": "Associates users with companies and their roles",
      "columns": ["company_id", "user_id", "role", "created_by", "created_on", "modified_by", "modified_on", "company_user_mapping_archive_id"]
    },
    {
      "tableName": "accounts",
      "description": "Account information for billing and entitlements",
      "columns": ["account_id", "account_name", "account_type", "account_source", "modified_on"]
    },
    {
      "tableName": "user_account_mapping",
      "description": "Maps users to accounts with roles and status",
      "columns": ["user_id", "account_id", "role", "created_on", "modified_on", "status"]
    },
    {
      "tableName": "entitlements",
      "description": "Product entitlements and licenses for accounts",
      "columns": ["entitlement_id", "ecom_source", "entitlement_type", "sku", "owner_id", "ent_created_on", "ent_expiry_on", "ent_modified_on"]
    },
    {
      "tableName": "entitlement_accounts",
      "description": "Links entitlements to specific accounts",
      "columns": ["id", "entitlement_id", "account_id", "account_type", "is_primary", "ent_account_modified_on"]
    },
    {
      "tableName": "entitlements_feature_usage",
      "description": "Feature usage limits and consumption for entitlements",
      "columns": ["entitlement_id", "feature_type_id", "max_limit", "usage_limit", "ent_feature_usage_modified_on"]
    },
    {
      "tableName": "feature_type",
      "description": "Defines available features and their default values",
      "columns": ["id", "external_feature_code", "feature_type", "default_value", "feature_type_created_on", "feature_type_modified_on", "type"]
    },
    {
      "tableName": "sku_feature_mapping",
      "description": "Maps SKUs to features with maximum values",
      "columns": ["sku", "feature_type_id", "max_value", "sku_feature_mapping_created_on", "sku_feature_mapping_modified_on"]
    },
    {
      "tableName": "skus",
      "description": "Product SKUs from different sources (ECOM, etc.)",
      "columns": ["sku", "source", "name", "type", "modified_on"]
    },
    {
      "tableName": "subscriptions_usage",
      "description": "Tracks feature usage across subscriptions and projects",
      "columns": ["id", "entitlement_id", "subscription_usage_log_id", "project_id", "account_id", "region", "feature_type_id", "feature_usage", "sub_usage_created_on", "sub_usage_modified_on"]
    },
    {
      "tableName": "user_activations",
      "description": "User activation records for entitlements",
      "columns": ["user_id", "activation_id", "entitlement_id", "type", "user_activation_assigned_on", "user_activation_created_on", "user_activation_expiry_on", "user_activation_modified_on", "status"]
    },
    {
      "tableName": "user_activations_free",
      "description": "Free tier user activations",
      "columns": ["user_id", "activation_id", "entitlement_id", "type", "user_activations_free_assigned_on", "user_activations_free_created_on", "user_activations_free_expiry_on", "user_activations_free_modified_on", "status"]
    },
    {
      "tableName": "tag",
      "description": "Tags/labels that can be applied to objects",
      "columns": ["tag_id", "project_id", "created_by", "tag_created_on", "modified_by", "tag_modified_on", "is_deleted", "deleted_by", "deleted_on", "source_region"]
    },
    {
      "tableName": "todo",
      "description": "Todo items/tasks with due dates and completion tracking",
      "columns": ["todo_id", "type", "todo_start_date", "todo_due_date", "status_label_id", "priority_label_id", "project_id", "storage_object_id", "is_milestone", "percent_complete", "created_by", "is_deleted", "deleted_by", "modified_by", "todo_created_on", "todo_modified_on", "source_region"]
    },
    {
      "tableName": "issue",
      "description": "Issues/topics created in projects with BCF support (NoSQL structure)",
      "columns": ["pk", "sk", "projectid", "fileid", "contextid", "serverassignedid", "title", "description", "createdby", "updatedby", "createdat", "updatedat", "deleted", "marker", "referencelinks", "percentage_complete", "priority", "stage", "status", "type", "id", "source_region"]
    },
    {
      "tableName": "session",
      "description": "User session tracking for authentication",
      "columns": ["session_id", "user_id", "remote_ip", "user_agent", "session_created_on", "source_region"]
    },
    {
      "tableName": "app_session_uuid",
      "description": "Application session tracking with UUID-based identification",
      "columns": ["session_uuid", "user_id", "created", "session_type", "last_accessed", "tid_uuid", "remote_ip", "user_agent"]
    },
    {
      "tableName": "permission",
      "description": "Permission definitions for different object types and operations",
      "columns": ["permission_id", "object_type_id", "operation", "weight", "permission_created_on", "source_region"]
    },
    {
      "tableName": "role",
      "description": "Role definitions with scope and permissions",
      "columns": ["role_id", "role_name", "scope_entity_id", "scope_entity_type", "is_system", "role_type", "activity_id", "orig_role_id", "role_created_by", "role_created_on", "source_region"]
    },
    {
      "tableName": "actor_permission_archive",
      "description": "Historical record of permissions granted to actors (users/groups)",
      "columns": ["actor_permission_archive_id", "actor_id", "actor_type", "object_id", "object_type_id", "permission_or_role_id", "is_role", "actor_permission_archive_created_on", "source_region"]
    },
    {
      "tableName": "revision_log",
      "description": "Version control history for storage objects",
      "columns": ["revision_log_id", "activity_id", "old_storage_object_id", "new_storage_object_id", "action", "revision_log_created_on", "source_region"]
    },
    {
      "tableName": "email",
      "description": "Email notification types and templates",
      "columns": ["email_id", "type", "email_created_on", "source_region"]
    },
    {
      "tableName": "compliance_user",
      "description": "User compliance status for regulatory requirements",
      "columns": ["user_id", "uuid", "compliance_req", "compliance_status", "compliance_user_created_on", "compliance_user_modified_on"]
    },
    {
      "tableName": "system_sku",
      "description": "System-level SKUs for internal operations",
      "columns": ["sku", "type", "account_id", "account_name", "system_sku_created_on", "system_sku_modified_on"]
    },
    {
      "tableName": "trial_sku",
      "description": "Trial SKUs for evaluation purposes",
      "columns": ["sku", "trial_sku_created_on"]
    },
    {
      "tableName": "project_id_mapping",
      "description": "Maps numeric project IDs to VID (visual IDs)",
      "columns": ["project_numeric_id", "project_vid", "source_region"]
    },
    {
      "tableName": "account_user_mapping",
      "description": "Maps users to accounts with project count tracking",
      "columns": ["account_id", "user_id", "active_projects_count", "modified_on"]
    },
    {
      "tableName": "account_user_mapping_kitchen",
      "description": "Kitchen sink table for account user mapping (data processing/staging)",
      "columns": ["account_id", "user_id", "active_projects_count", "modified_on"]
    },
    {
      "tableName": "account_user_project_mapping",
      "description": "Three-way mapping between accounts, users, and projects",
      "columns": ["user_id", "project_id", "account_id", "account_modified_on", "modified_on", "region", "status"]
    },
    {
      "tableName": "account_user_project_mapping_kitchen",
      "description": "Kitchen sink table for account user project mapping (data processing/staging)",
      "columns": ["user_id", "project_id", "account_id", "account_modified_on", "modified_on", "region", "status"]
    }
  ],
  "views": [
    {
      "viewName": "activity_view",
      "description": "Simplified view of user activities with date formatting",
      "baseTable": "activity",
      "columns": ["activity_id", "user_id", "project_id", "scope", "action", "status", "source_region", "activity_created_on"]
    },
    {
      "viewName": "project_view",
      "description": "Project information view with formatted dates",
      "baseTable": "project", 
      "columns": ["project_id", "root_id", "has_image", "sync_setting", "is_deleted", "deleted_by", "created_by", "modified_by", "is_project_invite_restricted", "source_region", "project_deleted_on", "project_created_on", "project_modified_on"]
    },
    {
      "viewName": "storage_object_view",
      "description": "File and folder view with computed extension field",
      "baseTable": "storage_object",
      "columns": ["storage_object_id", "orig_storage_object_id", "content_id", "revision", "type", "name", "project_id", "created_by", "modified_by", "size_in_bytes", "flag", "tds_fs_id", "source_region", "extension", "storage_object_created_on", "storage_object_modified_on"]
    },
    {
      "viewName": "user_view",
      "description": "User information view with formatted dates",
      "baseTable": "user",
      "columns": ["user_id", "tid_uuid", "status", "type", "trn", "has_image", "source_region", "user_created_on", "user_modified_on"]
    },
    {
      "viewName": "todo_view",
      "description": "Todo items with formatted dates and due date tracking",
      "baseTable": "todo",
      "columns": ["todo_id", "type", "todo_due_date", "status_label_id", "priority_label_id", "project_id", "storage_object_id", "is_milestone", "percent_complete", "created_by", "is_deleted", "deleted_by", "modified_by", "source_region", "todo_start_date", "todo_created_on", "todo_modified_on"]
    },
    {
      "viewName": "entitlements_view", 
      "description": "Entitlements and licenses view with owner UUID",
      "baseTable": "entitlements",
      "columns": ["entitlement_id", "ecom_source", "entitlement_type", "sku", "owner_uuid", "ent_created_on", "ent_expiry_on", "ent_modified_on"]
    },
    {
      "viewName": "user_activations_view",
      "description": "User activations with UUID-based user identification",
      "baseTable": "user_activations", 
      "columns": ["user_uuid", "activation_id", "entitlement_id", "type", "status", "user_activation_assigned_on", "user_activation_created_on", "user_activation_expiry_on", "user_activation_modified_on"]
    },
    {
      "viewName": "subscriptions_usage_view",
      "description": "Feature usage tracking across subscriptions with project VID",
      "baseTable": "subscriptions_usage",
      "columns": ["id", "entitlement_id", "subscription_usage_log_id", "project_vid", "account_id", "region", "feature_type_id", "feature_usage", "sub_usage_created_on", "sub_usage_modified_on"]
    },
    {
      "viewName": "project_id_mapping_view",
      "description": "Mapping between numeric project IDs and visual IDs",
      "baseTable": "project_id_mapping",
      "columns": ["project_id", "project_vid"]
    }
  ],
  "columns": [
    {
      "columnName": "activity_id",
      "tableName": "activity",
      "description": "Unique identifier for each activity record",
      "dataType": "bigint",
      "PK": "activity.activity_id",
      "FK": null
    },
    {
      "columnName": "user_id", 
      "tableName": "activity",
      "description": "ID of the user who performed the activity",
      "dataType": "bigint",
      "PK": null,
      "FK": "activity.user_id = user.user_id"
    },
    {
      "columnName": "project_id",
      "tableName": "activity", 
      "description": "ID of the project where activity occurred",
      "dataType": "bigint",
      "PK": null,
      "FK": "activity.project_id = project.project_id"
    },
    {
      "columnName": "project_id",
      "tableName": "project",
      "description": "Unique identifier for each project",
      "dataType": "bigint", 
      "PK": "project.project_id",
      "FK": null
    },
    {
      "columnName": "name",
      "tableName": "project",
      "description": "Display name of the project",
      "dataType": "varchar",
      "PK": null,
      "FK": null
    },
    {
      "columnName": "storage_object_id",
      "tableName": "storage_object",
      "description": "Unique identifier for files and folders",
