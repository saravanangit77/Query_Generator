      "PK": null,
      "FK": null
    },
    {
      "columnName": "size_in_bytes",
      "tableName": "storage_object",
      "description": "Size of the file in bytes",
      "dataType": "bigint",
      "PK": null,
      "FK": null
    },
    {
      "columnName": "user_id",
      "tableName": "user",
      "description": "Unique identifier for each user account", 
      "dataType": "bigint",
      "PK": "user.user_id",
      "FK": null
    },
    {
      "columnName": "tid_uuid", 
      "tableName": "user",
      "description": "Trimble ID UUID for user identification",
      "dataType": "varchar(50)",
      "PK": null,
      "FK": null,
      "unique": true
    },
    {
      "columnName": "todo_id",
      "tableName": "todo",
      "description": "Unique identifier for todo items",
      "dataType": "bigint",
      "PK": "todo.todo_id",
      "FK": null
    },
    {
      "columnName": "todo_due_date",
      "tableName": "todo", 
      "description": "Due date for todo completion",
      "dataType": "date",
      "PK": null,
      "FK": null
    },
    {
      "columnName": "project_id",
      "tableName": "todo",
      "description": "ID of the project containing this todo",
      "dataType": "bigint",
      "PK": null,
      "FK": "todo.project_id = project.project_id"
    },
    {
      "columnName": "storage_object_id",
      "tableName": "todo",
