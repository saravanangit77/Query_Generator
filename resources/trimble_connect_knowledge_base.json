    },
    {
      "columnName": "serverassignedid",
      "tableName": "issue",
      "description": "Human-readable issue identifier (e.g., ISSUE-123)",
      "dataType": "string",
      "PK": null,
      "FK": null
    },
    {
      "columnName": "title",
      "tableName": "issue",
