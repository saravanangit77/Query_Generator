      "PK": "entitlements.entitlement_id", 
      "FK": null
    },
    {
      "columnName": "sku",
      "tableName": "entitlements",
      "description": "Product SKU associated with this entitlement",
      "dataType": "varchar(100)",
      "PK": null,
      "FK": "entitlements.sku = skus.sku"
    },
    {
      "columnName": "owner_id",
      "tableName": "entitlements",
      "description": "UUID of the entitlement owner",
      "dataType": "varchar(50)",
      "PK": null,
      "FK": null
    },
    {
      "columnName": "account_id",
      "tableName": "accounts",
      "description": "Unique identifier for billing accounts",
      "dataType": "varchar(50)",
      "PK": "accounts.account_id",
      "FK": null
    },
    {
      "columnName": "account_id",
      "tableName": "entitlement_accounts", 
      "description": "Account ID linked to entitlement",
      "dataType": "varchar(36)",
      "PK": null,
      "FK": "entitlement_accounts.account_id = accounts.account_id"
    },
    {
      "columnName": "entitlement_id",
      "tableName": "entitlement_accounts",
      "description": "Entitlement ID being linked to account",
      "dataType": "varchar(50)",
      "PK": null,
      "FK": "entitlement_accounts.entitlement_id = entitlements.entitlement_id"
    },
    {
      "columnName": "feature_type_id",
      "tableName": "feature_type",
      "description": "Unique identifier for feature types",
      "dataType": "bigint",
      "PK": "feature_type.id", 
      "FK": null
    },
    {
      "columnName": "external_feature_code",
      "tableName": "feature_type",
      "description": "External system feature code for integration",
      "dataType": "varchar(50)",
      "PK": null,
      "FK": null
    },
    {
      "columnName": "feature_type_id",
      "tableName": "entitlements_feature_usage",
      "description": "Feature type being tracked for usage",
      "dataType": "bigint",
      "PK": null,
      "FK": "entitlements_feature_usage.feature_type_id = feature_type.id"
    },
    {
      "columnName": "max_limit",
      "tableName": "entitlements_feature_usage",
      "description": "Maximum allowed usage for this feature",
      "dataType": "bigint",
      "PK": null,
      "FK": null
    },
    {
      "columnName": "usage_limit",
      "tableName": "entitlements_feature_usage",
      "description": "Current usage count for this feature",
      "dataType": "bigint",
      "PK": null,
      "FK": null
    },
    {
